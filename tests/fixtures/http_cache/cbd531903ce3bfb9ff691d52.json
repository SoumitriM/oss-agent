 6, "deletions": 3}, "files": [{"sha": "f8a2355e75d92b57c97f634415718364d1c76ca1", "filename": "skills/skill-security-review/references/patterns.md", "status": "modified", "additions": 2, "deletions": 1, "changes": 3, "blob_url": "https://github.com/dkleptsov/skill-security-review/blob/d19fd5eff9762bada5ab2f18b0417f7e8d3f4fef/skills%2Fskill-security-review%2Freferences%2Fpatterns.md", "raw_url": "https://github.com/dkleptsov/skill-security-review/raw/d19fd5eff9762bada5ab2f18b0417f7e8d3f4fef/skills%2Fskill-security-review%2Freferences%2Fpatterns.md", "contents_url": "https://api.github.com/repos/dkleptsov/skill-security-review/contents/skills%2Fskill-security-review%2Freferences%2Fpatterns.md?ref=d19fd5eff9762bada5ab2f18b0417f7e8d3f4fef", "patch": "@@ -169,7 +169,8 @@ made these rules unreachable on real data:\n - A recorded session is **streamed line by line**, not read into memory. Real transcripts\n   run to tens of megabytes (a 51 MB local session yielded 191 reasoning blocks in half a\n   second); the 2 MB read limit that protects the rest of the scan would have skipped it\n-  whole.\n+  whole. An oversized file whose *name* looks like a transcript is streamed too, so\n+  renaming `session.jsonl` to `session.json` does not buy an exemption.\n - **Long lines still get the trace and secret rules.** One JSON object per line, and a\n   single signature value runs past 20 000 characters, so the 4 000-character line guard\n   used to hide exactly the blocks being hunted. Past that length the noisier rules are"}, {"sha": "41d185481603fd8756bf1c6127dee648d7122103", "filename": "skills/skill-security-review/scripts/scan.mjs", "status": "modified", "additions": 4, "deletions": 2, "changes": 6, "blob_url": "https://github.com/dkleptsov/skill-security-review/blob/d19fd5eff9762bada5ab2f18b0417f7e8d3f4fef/skills%2Fskill-security-review%2Fscripts%2Fscan.mjs", "raw_url": "https://github.com/dkleptsov/skill-security-review/raw/d19fd5eff9762bada5ab2f18b0417f7e8d3f4fef/skills%2Fskill-security-review%2Fscripts%2Fscan.mjs", "contents_url": "https://api.github.com/repos/dkleptsov/skill-security-review/contents/skills%2Fskill-security-review%2Fscripts%2Fscan.mjs?ref=d19fd5eff9762bada5ab2f18b0417f7e8d3f4fef", "patch": "@@ -705,10 +705,12 @@ function main() {\n     if (readable && size <= MAX_FILE_BYTES) {\n       try { text = readFileSync(f, 'utf-8'); } catch { /* ignore */ }\n       if (kind === 'code' && isVendoredByContent(text)) kind = 'vendored';\n-    } else if (kind === 'trace' && size <= MAX_TRACE_BYTES) {\n+    } else if ((kind === 'trace' || TRANSCRIPT_NAME.test(rel)) && size <= MAX_TRACE_BYTES) {\n       // Real transcripts run to tens of megabytes, well over the read limit\n       // that protects the rest of the scan, and skipping one would silently\n-      // disable the very rules it exists for. Stream it instead.\n+      // disable the very rules it exists for. Stream it instead. The name test\n+      // is what stops `session.json` from dodging this by not being .jsonl.\n+      kind = 'trace';\n       streamed.add(f);\n       notes.push(`Streamed line by line, too large to hold in memory: ${rel} (${size} bytes).`);\n     } else if (readable) {"}]}}