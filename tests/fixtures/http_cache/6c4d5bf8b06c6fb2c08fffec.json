s_url": "https://api.github.com/users/web-flow/subscriptions", "organizations_url": "https://api.github.com/users/web-flow/orgs", "repos_url": "https://api.github.com/users/web-flow/repos", "events_url": "https://api.github.com/users/web-flow/events{/privacy}", "received_events_url": "https://api.github.com/users/web-flow/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "32b50a4af020667ab6cdc64bf73aaf4d6fcbc2d1", "url": "https://api.github.com/repos/angular/.github/commits/32b50a4af020667ab6cdc64bf73aaf4d6fcbc2d1", "html_url": "https://github.com/angular/.github/commit/32b50a4af020667ab6cdc64bf73aaf4d6fcbc2d1"}], "stats": {"total": 65, "additions": 65, "deletions": 0}, "files": [{"sha": "c3c5a7171cc2e7671924841eb62098565f5f12b6", "filename": ".allstar/README.md", "status": "added", "additions": 34, "deletions": 0, "changes": 34, "blob_url": "https://github.com/angular/.github/blob/e3817880d4397ad344e9e686a9d77cca446d6357/.allstar%2FREADME.md", "raw_url": "https://github.com/angular/.github/raw/e3817880d4397ad344e9e686a9d77cca446d6357/.allstar%2FREADME.md", "contents_url": "https://api.github.com/repos/angular/.github/contents/.allstar%2FREADME.md?ref=e3817880d4397ad344e9e686a9d77cca446d6357", "patch": "@@ -0,0 +1,34 @@\n+# Allstar configuration for Angular\n+\n+[Allstar](https://github.com/ossf/allstar) is a security-policy GitHub app. It is\n+installed for all repositories in the Angular organization. This repository contains the root\n+configuration for the app.\n+\n+## Enabled Repos\n+\n+Currently Allstar is enabled on only the following repositories:\n+\n+- [angular/angular](https://github.com/angular/angular)\n+- [angular/angular-cli](https://github.com/angular/angular-cli)\n+- [angular/components](https://github.com/angular/components)\n+- [angular/dev-infra](https://github.com/angular/dev-infra)\n+\n+\n+## Policy Configuration\n+\n+### [Branch Protection](branch_protection.yaml)\n+\n+We do not currently require branch protection as we enforce our restrictions via rulesets.\n+\n+### [Outside Collaborators](outside.yaml)\n+\n+- Push access not allowed.\n+- Admin access not allowed.\n+\n+### [SECURITY.md](security.yaml)\n+\n+- SECURITY.md required.\n+\n+### [Binary Artifacts](binary_artifacts.yaml)\n+\n+- No binary artifacts are allowed to be commited to the repository."}, {"sha": "cea8a1dcae7eb0c8e15861c275ce964944e463ad", "filename": ".allstar/allstar.yaml", "status": "added", "additions": 9, "deletions": 0, "changes": 9, "blob_url": "https://github.com/angular/.github/blob/e3817880d4397ad344e9e686a9d77cca446d6357/.allstar%2Fallstar.yaml", "raw_url": "https://github.com/angular/.github/raw/e3817880d4397ad344e9e686a9d77cca446d6357/.allstar%2Fallstar.yaml", "contents_url": "https://api.github.com/repos/angular/.github/contents/.allstar%2Fallstar.yaml?ref=e3817880d4397ad344e9e686a9d77cca446d6357", "patch": "@@ -0,0 +1,9 @@\n+optConfig:\n+  optInRepos:\n+    - .allstar\n+    - angular\n+    - angular-cli\n+    - components\n+    - dev-infra\n+issueRepo: dev-infra\n+issueLabel: \"org policy violation\""}, {"sha": "8cb5d56bec706199d0034794384193535e4b572d", "filename": ".allstar/binary_artifacts.yaml", "status": "added", "additions": 12, "deletions": 0, "changes": 12, "blob_url": "https://github.com/angular/.github/blob/e3817880d4397ad344e9e686a9d77cca446d6357/.allstar%2Fbinary_artifacts.yaml", "raw_url": "https://github.com/angular/.github/raw/e3817880d4397ad344e9e686a9d77cca446d6357/.allstar%2Fbinary_artifacts.yaml", "contents_url": "https://api.github.com/repos/angular/.github/contents/.allstar%2Fbinary_artifacts.yaml?ref=e3817880d4397ad344e9e686a9d77cca446d6357", "patch": "@@ -0,0 +1,12 @@\n+optConfig:\n+  optOutStrategy: true\n+  optOutArchivedRepos: true\n+  optOutRepos:\n+    - angular.js\n+    - clang-format\n+    - clutz\n+    - builtwith.angularjs.org\n+    - jstd-jasmine\n+    - angular-jquery-ui\n+    - angular.js\n+action: issue"}, {"sha": "cf2bcb1031c0c25cb2cea506ee89b39b5c1bf7e1", "filename": ".allstar/outside.yaml", "status": "added", "additions": 6, "deletions": 0, "changes": 6, "blob_url": "https://github.com/angular/.github/blob/e3817880d4397ad344e9e686a9d77cca446d6357/.allstar%2Foutside.yaml", "raw_url": "https://github.com/angular/.github/raw/e3817880d4397ad344e9e686a9d77cca446d6357/.allstar%2Foutside.yaml", "contents_url": "https://api.github.com/repos/angular/.github/contents/.allstar%2Foutside.yaml?ref=e3817880d4397ad344e9e686a9d77cca446d6357", "patch": "@@ -0,0 +1,6 @@\n+optConfig:\n+  optOutStrategy: true\n+  optOutArchivedRepos: true\n+action: issue\n+adminAllowed: false\n+pushAllowed: false"}, {"sha": "8e3c4722bd038a59efb405ffae388fcdab3df61b", "filename": ".allstar/security.yaml", "status": "added", "additions": 4, "deletions": 0, "changes": 4, "blob_url": "https://github.com/angular/.github/blob/e3817880d4397ad344e9e686a9d77cca446d6357/.allstar%2Fsecurity.yaml", "raw_url": "https://github.com/angular/.github/raw/e3817880d4397ad344e9e686a9d77cca446d6357/.allstar%2Fsecurity.yaml", "contents_url": "https://api.github.com/repos/angular/.github/contents/.allstar%2Fsecurity.yaml?ref=e3817880d4397ad344e9e686a9d77cca446d6357", "patch": "@@ -0,0 +1,4 @@\n+optConfig:\n+  optOutArchivedRepos: true\n+  optOutStrategy: true\n+action: issue"}]}}