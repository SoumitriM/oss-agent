# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...  # only needed with LLM_PROVIDER=anthropic
OPENROUTER_API_KEY=sk-or-...  # only needed with LLM_PROVIDER=openrouter
GITHUB_TOKEN=ghp...          # read-only, no scopes needed (raises rate limit to 5000/h)
NVD_API_KEY=                  # optional, raises NVD rate limit
LLM_PROVIDER=claude_cli       # claude_cli (uses your Claude Code login) | anthropic (API key) | openrouter (API key)
LLM_MODEL=claude-sonnet-5-5   # only for tests/eval.py; the CLI and server use Sonnet, or Haiku with --haiku
